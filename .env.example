# Publik (terbawa ke browser; aman jika RLS benar)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (JANGAN pakai awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Hanya untuk E2E alur admin (Playwright). Akun uji Supabase, jangan pernah dikomit.
# Kosong = blok E2E admin dilewati (lihat e2e/admin-flow.spec.ts).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Produksi (VPS) ---
# Di VPS, file ini disalin sebagai `/opt/portfolio/.env` (chmod 600) dan dibaca
# docker-compose.yml. Nilai NEXT_PUBLIC_* di-atas sudah dibekukan ke image saat build
# lewat build-args; tetap tulis di sini agar kode server tetap membacanya saat runtime.
# IMAGE_TAG opsional untuk rollback ke tag sha tertentu (lihat DEPLOY.md §7).
# IMAGE_TAG=latest
